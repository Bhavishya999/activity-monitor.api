DATABASE_URL=postgres://gam:gam@localhost:5432/gam_dev
TEST_DATABASE_URL=postgres://gam:gam@localhost:5432/gam_test

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=   # PEM, \n-escaped; set via Railway secret
GITHUB_WEBHOOK_SECRET=

# Auth — generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=
SUPER_ADMIN_EMAIL=admin@orotron.com
SUPER_ADMIN_PASSWORD=   # set before running npm run seed, then remove

# Email / SMTP (leave blank in dev — OTP will be logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@orotron.com

REPORT_TIMEZONE=Asia/Kolkata

# Slack — daily report webhook (leave blank to skip Slack notifications)
SLACK_WEBHOOK_URL=

# CORS — set to your frontend URL in production (no trailing slash)
CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=https://activity-monitor-app.vercel.app
