{
  "name": "activity-monitor-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "migrations:gen": "drizzle-kit generate",
    "migrations:run": "tsx src/database/run-migrations.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8",
    "vitest": "5.0.5"
  }
}
